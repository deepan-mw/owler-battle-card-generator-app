# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Meltwater MCP (Media: statistics/document/profiles/query_gen).
# MCP (JSON-RPC Streamable-HTTP) endpoint. _resolve_statistics_fns detects the "/mcp"
# URL and uses make_mcp_tool_fn (initialize -> tools/call) automatically.
# AUTH: confirmed live 2026-06-02 that the api-key (APIM subscription key) ALONE
# authenticates this endpoint — the two lines below are all you need. Run from a
# VPN-connected / networked machine (the endpoint is internal).
MELTWATER_MCP_URL=<your-mcp-url>
MELTWATER_MCP_API_KEY=<your-apim-subscription-key>

# If the statistics tool name differs in prod, override it:
# MELTWATER_MCP_STATS_TOOL=unified_retrieval_statistics_retrieval_tool

# OPTIONAL — Bearer JWT. NOT needed for the current endpoint (api-key is enough). Only
# set this if a future endpoint requires user-scoped OAuth. To mint one:
#   python3 scripts/get_meltwater_token.py   (Auth0 auth-code+PKCE; writes it here)
# NOTE: that flow currently hits an Auth0 access_denied — the dynamically-registered
# client isn't authorized for the MCP API audience (needs admin/first-party client_id).
# MELTWATER_MCP_JWT=
# MELTWATER_OAUTH_AUDIENCE=<API identifier from the MCP WWW-Authenticate header>
# MELTWATER_OAUTH_CLIENT_ID=     # a pre-provisioned first-party client (skips DCR)

# Per-source MCPs (set when provisioned; each independent).
# OWLER_MCP_URL=
# OWLER_MCP_JWT=
# GENAI_LENS_MCP_URL=
# GENAI_LENS_MCP_JWT=
# GONG_API_URL=
# GONG_API_TOKEN=

# Real LLM synthesis (optional; falls back to deterministic stub if unset).
# ANTHROPIC_API_KEY=
